# =============================================
# BTC Dynamic DCA Dashboard - 环境变量示例
# 复制为 .env 后按需修改
# =============================================

# 后端服务
PORT=4000
NODE_ENV=development

# 数据存储模式:
#   file     - 本地 JSON 文件（零配置，开箱即用）
#   postgres - PostgreSQL + Prisma（需先启动 database/docker-compose.yml）
DATABASE_MODE=file
DATABASE_URL=postgresql://btc_dca:btc_dca@localhost:5432/btc_dca

# 运行数据目录（缓存、设置、投资记录）
DATA_DIR=./data

# 前端开发服务器跨域白名单
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# 数据源（可选覆盖，默认无需修改）
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINMETRICS_API_URL=https://community-api.coinmetrics.io/v4

# 可选：Bitbo API（Pro++ 账户，charts.bitbo.io/profile/api/ 获取 Key）
# 配置后 MVRV / Puell / 200W MA 使用 Bitbo 权威真实数据，否则自动降级
BITBO_API_URL=https://charts.bitbo.io/api/v1
BITBO_API_KEY=
